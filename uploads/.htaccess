# Chặn thực thi PHP trong thư mục uploads
php_flag engine off
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8

# Chặn CGI execution
Options -ExecCGI

# Chặn directory listing
Options -Indexes

# Chỉ cho phép xem file, không thực thi
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8

# Bảo vệ file .htaccess
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>
